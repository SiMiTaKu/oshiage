{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-order"],
  "ignoreFiles": ["**/dist/**", "**/.svelte-kit/**", "**/node_modules/**"],
  "rules": {
    "selector-max-type": null,
    "color-function-notation": null,
    "alpha-value-notation": null,
    "declaration-block-single-line-max-declarations": null,
    "keyframes-name-pattern": null,
    "selector-class-pattern": null,
    "scss/at-rule-no-unknown": true,
    "at-rule-no-unknown": null,
    "media-query-no-invalid": null,
    "unit-disallowed-list": ["rem"],
    "property-disallowed-list": [
      "margin",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left"
    ],
    "scss/selector-no-union-class-name": true,
    "selector-pseudo-class-disallowed-list": ["global"],
    "order/properties-order": [
      "position",
      "display",
      "gap",
      "grid",
      "grid-area",
      "grid-auto-columns",
      "grid-auto-flow",
      "grid-auto-rows",
      "grid-column",
      "grid-column-end",
      "grid-column-start",
      "grid-row",
      "grid-row-end",
      "grid-row-start",
      "grid-template",
      "grid-template-areas",
      "grid-template-columns",
      "grid-template-rows",
      "width",
      "min-width",
      "max-width",
      "height",
      "min-height",
      "max-height",
      "margin",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left",
      "padding",
      "padding-top",
      "padding-right",
      "padding-bottom",
      "padding-left",
      "font",
      "font-family",
      "font-size",
      "font-style",
      "font-weight",
      "color",
      "border",
      "border-width",
      "border-style",
      "border-color",
      "border-radius",
      "background",
      "background-color",
      "background-image",
      "background-size",
      "background-position",
      "background-repeat",
      "transition",
      "animation"
    ]
  },
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "customSyntax": "postcss-html",
      "rules": {
        "scss/at-rule-no-unknown": true,
        "at-rule-no-unknown": null,
        "no-duplicate-selectors": null,
        "selector-max-type": null
      }
    },
    {
      "files": ["**/*.scss"],
      "customSyntax": "postcss-scss"
    }
  ]
}
