{
  "name": "@oshiage/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate:openapi": "tsx src/shared/openapi/write-openapi.ts",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test:unit": "jest --passWithNoTests --testMatch '<rootDir>/tests/unit/**/*.spec.ts'",
    "test:unit:only": "jest --passWithNoTests --testMatch '<rootDir>/tests/unit/**/*.spec.ts'",
    "test:integration": "jest --passWithNoTests --testMatch '<rootDir>/tests/integration/**/*.spec.ts'",
    "test:integration:only": "jest --passWithNoTests --testMatch '<rootDir>/tests/integration/**/*.spec.ts'",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.20",
    "@nestjs/core": "^11.0.20",
    "@nestjs/platform-express": "^11.0.20",
    "@nestjs/swagger": "^11.1.2",
    "@prisma/client": "^6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.20",
    "dotenv": "^16.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "prisma": "^6.6.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
