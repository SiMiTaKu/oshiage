{
  "name": "oshiage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "dev:backend": "pnpm --filter @oshiage/backend start:dev",
    "dev:web": "pnpm --filter @oshiage/web dev",
    "dev:admin": "pnpm --filter @oshiage/admin dev",
    "dev:storybook": "pnpm --filter @oshiage/design-system storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:openapi": "pnpm --filter @oshiage/backend generate:openapi",
    "generate:sdk": "pnpm run generate:openapi && pnpm exec orval --config ./openapi/orval.config.ts",
    "lint": "eslint . && stylelint \"**/*.{css,svelte}\"",
    "prepare": "husky",
    "test:backend": "pnpm --filter @oshiage/backend test",
    "test:backend:unit": "pnpm --filter @oshiage/backend test:unit",
    "test:backend:unit:only": "sh -c 'pnpm --filter @oshiage/backend test:unit:only -- \"${1#backend/}\"' --",
    "test:backend:integration": "pnpm --filter @oshiage/backend test:integration",
    "test:backend:integration:only": "sh -c 'pnpm --filter @oshiage/backend test:integration:only -- \"${1#backend/}\"' --",
    "test:web": "pnpm --filter @oshiage/web test",
    "test:web:unit": "pnpm --filter @oshiage/web test:unit",
    "test:web:unit:only": "sh -c 'pnpm --filter @oshiage/web exec vitest run --passWithNoTests \"${1#web/}\"' --",
    "test:web:integration": "pnpm --filter @oshiage/web test:integration",
    "test:web:integration:only": "sh -c 'pnpm --filter @oshiage/web exec vitest run --passWithNoTests \"${1#web/}\"' --",
    "test:admin": "pnpm --filter @oshiage/admin test",
    "test:admin:unit": "pnpm --filter @oshiage/admin test:unit",
    "test:admin:unit:only": "sh -c 'pnpm --filter @oshiage/admin exec vitest run --passWithNoTests \"${1#admin/}\"' --",
    "test:admin:integration": "pnpm --filter @oshiage/admin test:integration",
    "test:admin:integration:only": "sh -c 'pnpm --filter @oshiage/admin exec vitest run --passWithNoTests \"${1#admin/}\"' --",
    "test:design-system": "pnpm --filter @oshiage/design-system test",
    "test:design-system:unit": "pnpm --filter @oshiage/design-system test:unit",
    "test:design-system:unit:only": "sh -c 'pnpm --filter @oshiage/design-system exec vitest run --passWithNoTests \"${1#design-system/}\"' --",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm audit && pnpm run lint && pnpm run format:check && pnpm run check && pnpm run test && pnpm run build"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,svelte}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-svelte": "^2.46.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "orval": "^7.21.0",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript-eslint": "^8.60.1"
  }
}
